local espEnabled = false
local espObjects = {}

local silentAimEnabled = false
local camlockEnabled = false
local hitChance = 100
local aimSmoothness = 0.5
local isAiming = false
local targetPartName = "HumanoidRootPart"

local sprintEnabled = false
local sprintSpeed = 16

local crosshairSize = 10
local crosshairThickness = 2
local crosshairGap = 5
local crosshairColor = Color3.fromRGB(255, 0, 0)

local lines = {}
if hasDrawing then
    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = crosshairColor
        line.Thickness = crosshairThickness
        line.Transparency = 1
        table.insert(lines, line)
    end
end

local function getKillerTargetPart()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team and player.Team.Name == "Killer" then
            local character = player.Character
            if character and character:FindFirstChild(targetPartName) and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                return character[targetPartName]
            end
        end
    end
    return nil
end

-- Inject hookmetamethod HANYA jika executor support
if hasHookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if method == "FireServer" and self.Name == "Fire" and silentAimEnabled then
            local targetPart = getKillerTargetPart()
            if targetPart then
                local chance = math.random(1, 100)
                if chance <= hitChance then
                    local origin = Camera.CFrame.Position
                    local direction = (targetPart.Position - origin).Unit
                    args[2] = direction
                    return oldNamecall(self, unpack(args))
                end
            end
        end

        return oldNamecall(self, ...)
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 and (camlockEnabled or silentAimEnabled) then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isAiming = false
    end
end)

RunService:BindToRenderStep("SanzyAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if camlockEnabled and isAiming then
        local targetPart = getKillerTargetPart()
        if targetPart then
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, aimSmoothness)
        end
    end
end)

RunService.RenderStepped:Connect(function()
    -- ESP Logic
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if espEnabled and character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                if not espObjects[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "PlayerESP"
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.1
                    highlight.Parent = character
                    espObjects[player] = highlight
                end
                
                local targetHighlight = espObjects[player]
                targetHighlight.Parent = character
                local targetColor = Color3.fromRGB(255, 255, 255)
                
                if player.Team then
                    if player.Team.Name == "Survivors" then
                        targetColor = player.TeamColor.Color
                    elseif player.Team.Name == "Killer" then
                        targetColor = Color3.fromRGB(255, 0, 0)
                    else
                        targetColor = player.TeamColor.Color
                    end
                end
                
                targetHighlight.FillColor = targetColor
                targetHighlight.OutlineColor = targetColor
            else
                if espObjects[player] then
                    espObjects[player]:Destroy()
                    espObjects[player] = nil
                end
            end
        end
    end

    -- Sprint Logic
    if sprintEnabled then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("Humanoid") then
            if character.Humanoid.WalkSpeed ~= sprintSpeed then
                character.Humanoid.WalkSpeed = sprintSpeed
            end
        end
    end

    -- Crosshair Logic
    if hasDrawing and #lines == 4 then
        if silentAimEnabled or camlockEnabled then
            local center = Camera.ViewportSize / 2
            local states = {
                {Vector2.new(center.X - crosshairGap - crosshairSize, center.Y), Vector2.new(center.X - crosshairGap, center.Y)},
                {Vector2.new(center.X + crosshairGap + crosshairSize, center.Y), Vector2.new(center.X + crosshairGap, center.Y)},
                {Vector2.new(center.X, center.Y - crosshairGap - crosshairSize), Vector2.new(center.X, center.Y - crosshairGap)},
                {Vector2.new(center.X, center.Y + crosshairGap + crosshairSize), Vector2.new(center.X, center.Y + crosshairGap)}
            }

            for i = 1, 4 do
                local line = lines[i]
                line.Visible = true
                line.Color = crosshairColor
                line.Thickness = crosshairThickness
                line.From = states[i][1]
                line.To = states[i][2]
            end
        else
            for i = 1, 4 do
                lines[i].Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if espObjects[player] then
        espObjects[player]:Destroy()
        espObjects[player] = nil
    end
end)

