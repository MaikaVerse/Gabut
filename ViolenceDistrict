Tabs.Misc:AddButton({
    Title = "Remove Game Blur / DOF",
    Description = "Hapus efek blur dan kabut dari map",
    Callback = function()
        for _, obj in pairs(Lighting:GetChildren()) do
            if obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("Atmosphere") or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") then
                obj.Enabled = false
            end
        end
        if Camera:FindFirstChildOfClass("BlurEffect") then
            Camera:FindFirstChildOfClass("BlurEffect").Enabled = false
        end
        if Camera:FindFirstChildOfClass("DepthOfFieldEffect") then
            Camera:FindFirstChildOfClass("DepthOfFieldEffect").Enabled = false
        end
        Lighting.FogEnd = 100000
        Fluent:Notify({Title = "Visual", Content = "Lighting dibersihkan!", Duration = 3})
    end
})

